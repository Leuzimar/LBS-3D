function doPost(e){try{const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName("Vendas")||ss.insertSheet("Vendas");if(sh.getLastRow()==0)sh.appendRow(["Data","Cliente","WhatsApp","Produto","Quantidade","Peso(g)","Horas","Custo","Venda","Lucro","Status"]);const d=JSON.parse(e.postData.contents||"{}");(d.vendas||[]).forEach(v=>sh.appendRow([new Date(v.data),v.cliente||"",v.whats||"",v.produto||"",v.q||0,v.peso||0,v.horas||0,v.custo||0,v.venda||0,v.lucro||0,v.status||""]));return ContentService.createTextOutput("Sincronização concluída.");}catch(err){return ContentService.createTextOutput("Erro: "+err.message)}}